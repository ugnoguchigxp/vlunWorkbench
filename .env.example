# Runtime
NODE_ENV=development
DATABASE_URL=file:./data/vuln-workbench.sqlite
CONTENT_ROOT=./wiki-knowledge
WIKI_STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
WIKI_BLOB_CONTAINER=wiki-knowledge
WIKI_BLOB_PREFIX=

# RAG providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
LLM_PROVIDER_ALLOWED_HOSTS=
# Generate with: openssl rand -base64 32
LLM_SETTINGS_ENCRYPTION_KEY=
LLM_SETTINGS_PREVIOUS_ENCRYPTION_KEYS=
DAST_AUTH_ENCRYPTION_KEY=
DAST_AUTH_PREVIOUS_ENCRYPTION_KEYS=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Auth
JWT_SECRET=vuln-workbench-dev-jwt-secret-change-this-for-production

# Origin / cookie mode
APP_URL=http://localhost:29831
CORS_ORIGINS=http://localhost:29831
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
SECURITY_HEADERS_MODE=auto
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
CSP_MODE=report-only

# Scanner execution, resource limits, and Codex timeout are managed in
# Settings > Runtime Settings and stored in SQLite.
# Optional non-core scanner adapters are disabled by default. After installing
# the engine or building its adapter image, opt in with a comma-separated list:
# VULN_WORKBENCH_OPTIONAL_SCANNER_ADAPTERS=semgrep

# Static Intelligence MCP path access (comma-separated absolute roots).
# Empty is fail-closed: every projectPath request is rejected.
STATIC_INTELLIGENCE_ALLOWED_PROJECT_ROOTS=
# registered_only (default) or create_within_allowed_roots
STATIC_INTELLIGENCE_PROJECT_CREATION_POLICY=registered_only

# NightWorkers integrations are disabled by default. Security Intelligence also
# requires a non-empty comma-separated UUID allowlist.
NIGHTWORKERS_INTEGRATION_ENABLED=false
NIGHTWORKERS_SECURITY_INTELLIGENCE_ENABLED=false
NIGHTWORKERS_SECURITY_INTELLIGENCE_AUTHORIZATION_SHADOW_ENABLED=false
NIGHTWORKERS_SECURITY_INTELLIGENCE_ALLOWED_PROJECT_IDS=
NIGHTWORKERS_SECURITY_INTELLIGENCE_MAX_RESPONSE_BYTES=2097152
NIGHTWORKERS_SECURITY_INTELLIGENCE_WORKSPACE_GRANT_ENABLED=false
NIGHTWORKERS_SECURITY_INTELLIGENCE_WORKSPACE_GRANT_TTL_SECONDS=300
NIGHTWORKERS_SECURITY_INTELLIGENCE_WORKSPACE_GRANT_MAX_REQUEST_BYTES=16384
