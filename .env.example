# Runtime
NODE_ENV=development
DATABASE_URL=file:./data/vuln-workbench.sqlite
CONTENT_ROOT=./wiki-knowledge
WIKI_STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
WIKI_BLOB_CONTAINER=wiki-knowledge
WIKI_BLOB_PREFIX=

# RAG providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
CODEX_SDK_TIMEOUT_MS=600000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Auth
JWT_SECRET=vuln-workbench-dev-jwt-secret-change-this-for-production

# Origin / cookie mode
APP_URL=http://localhost:29831
CORS_ORIGINS=http://localhost:29831
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
SECURITY_HEADERS_MODE=auto

# Scanner execution (production defaults to Docker; host requires explicit opt-in)
SCAN_EXECUTION_MODE=host
ALLOW_HOST_SCANNER_EXECUTION=true
SCAN_DOCKER_IMAGE=vuln-workbench-toolbox:local

# Static Intelligence MCP path access (comma-separated absolute roots).
# Empty is fail-closed: every projectPath request is rejected.
STATIC_INTELLIGENCE_ALLOWED_PROJECT_ROOTS=
# registered_only (default) or create_within_allowed_roots
STATIC_INTELLIGENCE_PROJECT_CREATION_POLICY=registered_only
