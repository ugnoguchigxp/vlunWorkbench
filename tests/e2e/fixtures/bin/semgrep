#!/usr/bin/env bun

const args = process.argv.slice(2);

if (args.includes("--version")) {
	console.log("semgrep 1.171.0");
	process.exit(0);
}

const outputFlagIndex = args.indexOf("--output");
const outputPath = outputFlagIndex >= 0 ? args[outputFlagIndex + 1] : undefined;
if (!outputPath) {
	console.error("E2E semgrep fixture requires --output.");
	process.exit(2);
}

await Bun.write(
	outputPath,
	JSON.stringify({
		results: [
			{
				check_id: "e2e.security.unsafe-eval",
				path: "src/example.ts",
				start: { line: 2, col: 9 },
				end: { line: 2, col: 28 },
				extra: {
					message: "E2E unsafe eval finding",
					lines: 'return eval("2 + 2");',
					severity: "ERROR",
					metadata: { cwe: "CWE-95" },
				},
			},
		],
		errors: [],
	}),
);
