{
	"name": "vuln-workbench",
	"version": "1.0.0",
	"description": "Local vulnerability diagnostic workbench for CLI scan evidence, LLM review, and human decisions.",
	"type": "module",
	"author": "",
	"license": "MIT",
	"keywords": [
		"security",
		"vulnerability",
		"scanning",
		"hono",
		"react",
		"typescript"
	],
	"scripts": {
		"dev": "bunx --bun vite",
		"dev:vite": "vite",
		"start": "bun run api/app/server.ts",
		"bootstrap": "bun run scripts/bootstrap.ts",
		"bootstrap:check": "bun run scripts/bootstrap-check.ts",
		"auth:create-admin": "bun run api/cli/auth-create-admin.ts",
		"audit:project-paths": "bun run api/cli/audit-project-paths.ts",
		"import:markdown": "bun run api/cli/import-markdown.ts",
		"db:generate": "drizzle-kit generate",
		"db:boundary": "bun run scripts/check-sqlite-write-boundary.ts",
		"db:writer": "bun run api/cli/sqlite-writer.ts",
		"db:writer:health": "bun run api/cli/sqlite-writer-health.ts",
		"db:migrate": "bun run api/cli/migrate.ts",
		"db:seed": "bun run api/cli/seed.ts",
		"backup:create": "bun run api/cli/backup-create.ts",
		"backup:verify": "bun run api/cli/backup-verify.ts",
		"llm-secrets:migrate": "bun run api/cli/migrate-llm-secrets.ts",
		"db:migrate:drizzle": "bun run db:migrate",
		"test": "bun run test:inventory -- --assert-complete && bun run test:web && bun run test:api",
		"test:inventory": "bun run scripts/test-inventory.ts",
		"test:web": "vitest run",
		"test:api": "bun run scripts/run-api-test-shards.ts",
		"test:coverage:web": "vitest run --coverage",
		"test:coverage:critical": "bun run scripts/check-critical-coverage.ts",
		"test:coverage": "bun run test:coverage:web && bun run test:coverage:critical",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint api web shared",
		"format": "biome format --write api web shared",
		"format:check": "biome format api web shared",
		"build:web": "vite build",
		"build": "bun run build:web",
		"check:audit": "bun run scripts/check-audit-policy.ts",
		"check:artifact-tracking": "bun run scripts/check-artifact-tracking.ts",
		"check:bundle": "bun run scripts/check-bundle-budget.ts",
		"scan:import": "bun run api/cli/scan-import.ts",
		"scan:semgrep": "bun run api/cli/scan-semgrep.ts",
		"scan:gitleaks": "bun run api/cli/scan-gitleaks.ts",
		"scan:osv": "bun run api/cli/scan-osv.ts",
		"scan:trivy": "bun run api/cli/scan-trivy.ts",
		"scan:nuclei": "bun run api/cli/scan-profile.ts -- --profile runtime-web-safe --step runtime_scanner:nuclei-safe",
		"scan:zap-baseline": "bun run api/cli/scan-profile.ts -- --profile runtime-zap-baseline --runner docker",
		"scan:sbom": "bun run api/cli/scan-profile.ts -- --profile sbom-inventory",
		"scan:schemathesis": "bun run api/cli/scan-profile.ts -- --profile api-schema-readonly",
		"scan:trivy-image": "bun run api/cli/scan-profile.ts -- --profile container-image-security",
		"scan:profile": "bun run api/cli/scan-profile.ts",
		"oracle:security": "bun run api/cli/oracle-security.ts",
		"scan:dast": "bun run api/cli/scan-dast.ts",
		"review:finding": "bun run api/cli/review-finding.ts",
		"review:scan": "bun run api/cli/review-scan.ts",
		"decision:finding": "bun run api/cli/decision-finding.ts",
		"report:scan": "bun run api/cli/report-scan.ts",
		"intelligence:export": "bun run api/cli/intelligence-export.ts",
		"intelligence:build": "bun run api/cli/intelligence-build.ts",
		"intelligence:index": "bun run api/cli/intelligence-index.ts",
		"intelligence:query": "bun run api/cli/intelligence-query.ts",
		"intelligence:communities": "bun run api/cli/intelligence-communities.ts",
		"intelligence:landscape": "bun run api/cli/intelligence-landscape.ts",
		"intelligence:agent-query": "bun run api/cli/intelligence-agent-query.ts",
		"intelligence:project-structure": "bun run api/cli/intelligence-project-structure.ts",
		"intelligence:exploration-catalog": "bun run api/cli/intelligence-exploration-catalog.ts",
		"intelligence:knowledge-source": "bun run api/cli/intelligence-knowledge-source.ts",
		"intelligence:guardrail-material": "bun run api/cli/intelligence-guardrail-material.ts",
		"mcp:static-intelligence": "bun run api/cli/static-intelligence-mcp-server.ts",
		"fixture:static-intelligence-source": "bun run scripts/static-intelligence-knowledge-source-fixture.ts",
		"fixture:static-intelligence-path-first": "bun test api/modules/static-intelligence/project-path-mcp.test.ts",
		"inventory:attack-surface": "bun run api/cli/inventory-attack-surface.ts",
		"check:security": "bun run api/cli/check-security.ts",
		"report:diagnostic": "bun run api/cli/report-diagnostic.ts",
		"repro:finding": "bun run api/cli/repro-finding.ts",
		"dynamic:run": "bun run api/cli/dynamic-run.ts",
		"docker:toolbox:build": "bun run scripts/build-toolbox-image.ts",
		"docker:dynamic:build": "bun run scripts/build-dynamic-image.ts",
		"verify": "bun scripts/verify.ts",
		"verify:strict": "bun run verify"
	},
	"files": [
		"dist-web",
		"README.md",
		"LICENSE.md",
		"package.json"
	],
	"dependencies": {
		"@azure/storage-blob": "^12.31.0",
		"@hono/zod-validator": "0.8.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@openai/codex-sdk": "^0.142.2",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.15",
		"@tanstack/react-table": "8.21.3",
		"cheerio": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.27",
		"jose": "6.2.3",
		"jsdom": "^26.0.0",
		"lucide-react": "1.18.0",
		"markdown-wysiwyg-editor": "^0.3.7",
		"mermaid": "^11.16.0",
		"postcss": "8.5.15",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.79.0",
		"sanitize-html": "^2.17.4",
		"sqlite-vec": "^0.1.9",
		"tailwind-merge": "^3.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.2",
		"@biomejs/biome": "2.5.0",
		"@hono/vite-dev-server": "0.26.0",
		"@playwright/test": "1.55.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/bun": "1.3.14",
		"@types/jsdom": "^28.0.3",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "6.0.2",
		"drizzle-kit": "0.31.10",
		"tailwindcss": "^4.3.1",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	},
	"overrides": {
		"@hono/node-server": "2.0.10",
		"brace-expansion": "2.1.2",
		"dompurify": "3.4.12",
		"esbuild": "0.28.1",
		"fast-uri": "3.1.4",
		"hono": "4.12.27",
		"picomatch": "4.0.4",
		"postcss": "8.5.15",
		"rollup": "4.62.0",
		"undici": "7.28.0",
		"vite": "8.0.16",
		"ws": "8.21.0"
	}
}
