{
	"name": "hono-standard",
	"version": "1.0.0",
	"description": "Minimal Hono + React template with optional login and showcase screens.",
	"type": "module",
	"author": "ugnoguchigxp <ugnoguchigxp@gmail.com>",
	"license": "MIT",
	"keywords": [
		"hono",
		"react",
		"vite",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ugnoguchigxp/hono-standard.git"
	},
	"bugs": {
		"url": "https://github.com/ugnoguchigxp/hono-standard/issues"
	},
	"homepage": "https://github.com/ugnoguchigxp/hono-standard#readme",
	"scripts": {
		"dev": "bunx --bun vite",
		"dev:vite": "vite",
		"bootstrap": "bun scripts/bootstrap.ts",
		"seed:dev": "bun scripts/seed-dev.ts",
		"start": "bun run api/app/server.ts",
		"auth:create-admin": "bun run api/cli/auth-create-admin.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run api/cli/migrate.ts",
		"db:migrate:drizzle": "drizzle-kit migrate",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint api web shared scripts tests drizzle.config.ts playwright.config.ts vite.config.ts vitest.config.ts",
		"format": "biome format --write api web shared scripts tests drizzle.config.ts playwright.config.ts vite.config.ts vitest.config.ts",
		"format:check": "biome format api web shared scripts tests drizzle.config.ts playwright.config.ts vite.config.ts vitest.config.ts",
		"build:web": "vite build",
		"build": "bun run build:web",
		"verify": "bun scripts/verify.ts",
		"verify:e2e": "bun run test:e2e",
		"verify:all": "bun run verify && bun run verify:e2e",
		"verify:strict": "bun run verify"
	},
	"dependencies": {
		"@hono/zod-validator": "0.8.0",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.15",
		"@tanstack/react-table": "8.21.3",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.25",
		"jose": "6.2.3",
		"lucide-react": "1.18.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.79.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@hono/vite-dev-server": "0.26.0",
		"@playwright/test": "1.61.1",
		"@tailwindcss/vite": "4.3.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "4.1.8",
		"drizzle-kit": "0.31.10",
		"jsdom": "29.1.1",
		"tailwindcss": "4.3.1",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"picomatch": "4.0.4",
		"postcss": "8.5.15",
		"vite": "8.0.16"
	}
}
