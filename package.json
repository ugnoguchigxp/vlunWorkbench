{
	"name": "vuln-workbench",
	"version": "1.0.0",
	"description": "Local vulnerability diagnostic workbench for CLI scan evidence, LLM review, and human decisions.",
	"type": "module",
	"author": "",
	"license": "MIT",
	"keywords": [
		"security",
		"vulnerability",
		"scanning",
		"hono",
		"react",
		"typescript"
	],
	"scripts": {
		"dev": "bunx --bun vite",
		"dev:vite": "vite",
		"start": "bun run api/app/server.ts",
		"bootstrap": "bun run scripts/bootstrap.ts",
		"bootstrap:check": "bun run scripts/bootstrap-check.ts",
		"auth:create-admin": "bun run api/cli/auth-create-admin.ts",
		"import:markdown": "bun run api/cli/import-markdown.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run api/cli/migrate.ts",
		"db:seed": "bun run api/cli/seed.ts",
		"db:migrate:drizzle": "drizzle-kit migrate",
		"test": "vitest run --exclude 'api/modules/scans/**/*.test.ts' --exclude 'api/modules/reviews/**/*.test.ts' --exclude 'api/modules/decisions/**/*.test.ts' --exclude 'api/modules/reproductions/**/*.test.ts' --exclude 'api/modules/dynamic/**/*.test.ts' --exclude 'api/modules/dast/**/*.test.ts' --exclude 'api/modules/llm-settings/**/*.test.ts' --exclude 'api/routes/reproductions.route.test.ts' --exclude 'api/routes/dynamic.route.test.ts' --exclude 'api/routes/dast.route.test.ts' --exclude 'api/routes/diagnostics.route.test.ts' --exclude 'api/providers/llmRouter.test.ts' && bun test ./api/modules/scans/*.test.ts ./api/modules/scans/**/*.test.ts ./api/modules/reviews/*.test.ts ./api/modules/reviews/**/*.test.ts ./api/modules/decisions/*.test.ts ./api/modules/decisions/**/*.test.ts ./api/modules/reproductions/*.test.ts ./api/modules/reproductions/**/*.test.ts ./api/modules/llm-settings/**/*.test.ts ./api/providers/llmRouter.test.ts ./api/routes/reproductions.route.test.ts ./api/modules/dynamic/**/*.test.ts ./api/routes/dynamic.route.test.ts ./api/routes/dast.route.test.ts ./api/routes/diagnostics.route.test.ts ./api/modules/dast/**/*.test.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint api web shared",
		"format": "biome format --write api web shared",
		"format:check": "biome format api web shared",
		"build:web": "vite build",
		"build": "bun run build:web",
		"scan:import": "bun run api/cli/scan-import.ts",
		"scan:semgrep": "bun run api/cli/scan-semgrep.ts",
		"scan:gitleaks": "bun run api/cli/scan-gitleaks.ts",
		"scan:osv": "bun run api/cli/scan-osv.ts",
		"scan:trivy": "bun run api/cli/scan-trivy.ts",
		"scan:profile": "bun run api/cli/scan-profile.ts",
		"scan:dast": "bun run api/cli/scan-dast.ts",
		"review:finding": "bun run api/cli/review-finding.ts",
		"review:scan": "bun run api/cli/review-scan.ts",
		"decision:finding": "bun run api/cli/decision-finding.ts",
		"report:scan": "bun run api/cli/report-scan.ts",
		"inventory:attack-surface": "bun run api/cli/inventory-attack-surface.ts",
		"check:security": "bun run api/cli/check-security.ts",
		"report:diagnostic": "bun run api/cli/report-diagnostic.ts",
		"repro:finding": "bun run api/cli/repro-finding.ts",
		"dynamic:run": "bun run api/cli/dynamic-run.ts",
		"docker:toolbox:build": "bun run scripts/build-toolbox-image.ts",
		"docker:dynamic:build": "bun run scripts/build-dynamic-image.ts",
		"verify": "bun scripts/verify.ts",
		"verify:strict": "bun run verify"
	},
	"files": [
		"dist-web",
		"README.md",
		"LICENSE.md",
		"package.json"
	],
	"dependencies": {
		"@azure/storage-blob": "^12.31.0",
		"@hono/zod-validator": "0.8.0",
		"@openai/codex-sdk": "^0.142.2",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.15",
		"@tanstack/react-table": "8.21.3",
		"cheerio": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.25",
		"jose": "6.2.3",
		"jsdom": "^26.0.0",
		"lucide-react": "1.18.0",
		"markdown-wysiwyg-editor": "^0.3.7",
		"mermaid": "^11.15.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.79.0",
		"sanitize-html": "^2.17.4",
		"sqlite-vec": "^0.1.9",
		"tailwind-merge": "^3.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@hono/vite-dev-server": "0.26.0",
		"@tailwindcss/vite": "^4.3.1",
		"@types/bun": "1.3.14",
		"@types/jsdom": "^21.1.7",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "6.0.2",
		"drizzle-kit": "0.31.10",
		"tailwindcss": "^4.3.1",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"picomatch": "4.0.4",
		"postcss": "8.5.15",
		"rollup": "4.62.0",
		"undici": "7.27.2",
		"vite": "8.0.16",
		"ws": "8.21.0"
	}
}
