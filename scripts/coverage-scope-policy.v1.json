		},
		{
			"path": "api/modules/dast/active-request-executor.ts",
			"reason": "Executor behavior is covered through active assessment runner characterization tests.",
			"tests": ["api/modules/dast/active-assessment-runner.test.ts"]
		},
		{
			"path": "api/modules/dynamic/dynamic-evaluator.ts",
			"reason": "Evaluation policy has dedicated paired outcome tests.",
			"tests": ["api/modules/dynamic/dynamic-evaluator.test.ts"]
		},
		{
			"path": "api/modules/dynamic/dynamic-repository.ts",
