{
	"version": 1,
	"selectedWebPatterns": [
		"web/src/agentic-markdown.ts",
		"web/src/domains/projects/*.ts",
		"web/src/domains/scans/*.ts",
		"shared/report-sections.ts"
	],
	"criticalSurfacePatterns": [
		"api/middleware/*.ts",
		"api/security/*.ts",
		"api/modules/dast/active-*.ts",
		"api/modules/dynamic/dynamic-*.ts",
		"api/modules/integrations/nightworkers/nightworkers-security-intelligence*.ts",
		"api/modules/reproductions/reproduction-run-*.ts",
